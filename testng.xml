<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Verona Mobile Automation" preserve-order="true">
    <listeners>
        <listener class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/>
        <listener class-name="club.verona.automation.core.TestRunListener"/>
        <listener class-name="club.verona.automation.core.RetryTransformer"/>
    </listeners>
    <test name="Profile">
        <groups>
            <run>
                <include name="ProfileFieldEditTests"/></run>
        </groups>
        <classes>
            <class name="club.verona.automation.tests.ProfileTests"/>
        </classes>
    </test>
    <test name="Onboarding">
        <groups>
            <run>
                <include name="OnboardingPageTests"/></run>
        </groups>
        <classes>
            <class name="club.verona.automation.tests.OnboardingPageTests"/>
        </classes>
    </test>
</suite>
