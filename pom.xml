<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>club.verona</groupId>
    <artifactId>verona-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- default platform; override with -Dplatform=ios -->
        <platform>android</platform>
    </properties>

    <repositories>
        <repository>
            <id>bestq</id>
            <name>BestQ Nexus Repository</name>
            <url>https://nexus.best-quality.in/repository/bestq/</url>
        </repository>
    </repositories>

    <!--
      bestqtestframework pulls in jackson-databind 2.13.3, okhttp 4.0.1, and
      (via other old transitive deps) kotlin-stdlib as old as 1.1.0; the
      ReportPortal agent's client (com.epam.reportportal:client-java) needs
      much newer versions of all three (its own okhttp -> okio dependency
      needs kotlin-stdlib 1.9.x). Maven's nearest-wins mediation would
      otherwise keep the old versions on the classpath, and
      ReportPortalTestNGListener's constructor throws NoSuchMethodError
      building its HTTP client — hard-failing the whole suite before any
      test runs. Pin all three so the build shares one resolved version.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.18.6</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.6</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.18.6</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>1.9.10</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-common</artifactId>
                <version>1.9.10</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk7</artifactId>
                <version>1.9.10</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>1.9.10</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>logging-interceptor</artifactId>
                <version>4.12.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>com.bestq.base</groupId>
            <artifactId>bestqtestframework</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <!--
                  bestqtestframework -> logger-java-log4j pulls in the standalone
                  commons-model:5.0.0 artifact, which ships its own copy of
                  com.epam.ta.reportportal.ws.model.* classes (e.g. StartLaunchRQ)
                  with an older API. Our agent-java-testng's client-java 5.4.12
                  bundles a newer version of those same classes internally, so
                  having both on the classpath means whichever jar loads first
                  wins — and it was the old one, breaking ReportPortal at
                  runtime with NoSuchMethodError. Exclude the standalone artifact
                  so only client-java's bundled classes are used.
                -->
                <exclusion>
                    <groupId>com.epam.reportportal</groupId>
                    <artifactId>commons-model</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>10.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
            <dependency>
                <groupId>com.epam.reportportal</groupId>
                <artifactId>agent-java-testng</artifactId>
                <version>5.6.8</version>
                <scope>test</scope>
            </dependency>

    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <systemPropertyVariables>
                        <platform>${platform}</platform>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
